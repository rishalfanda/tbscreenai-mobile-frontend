      "DiagnosisValidationPatch": {
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(pending|agreed|disagreed)$",
            "title": "Status"
          },
          "doctor_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Note",
            "description": "The doctor's note. Optional, also when disagreeing (Pak Wahyono's revision of 6 November); at most 500 characters."
          },
          "lesion_rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lesion Rating",
            "description": "The doctor's rating of the lesion result, on the validation slider: an integer from 0 to 10. Required with agreed or disagreed; not allowed with pending."
          },
          "validation_score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Validation Score",
            "description": "Deprecated. The slider's meaning from 1 November: the doctor's trust in the AI's result, 0 to 10. Still stored when sent, and never converted to or from `lesion_rating`; no longer required. Not allowed with pending."
          },
          "validated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Validated At",
            "description": "When the doctor confirmed, on the tablet. Send it for a validation made offline; left out, the server's time is used. Not later than the server's clock plus a few minutes."
          },
          "base_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
