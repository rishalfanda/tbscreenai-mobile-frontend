{
  "paths": {
    "/api/v1/diagnoses/{diagnosis_id}/status": {
      "patch": {
        "tags": [
          "diagnoses"
        ],
        "summary": "Update Status",
        "description": "Doctor validation verdict \u00e2\u20ac\u201d mirrors the Flutter ValidationScreen flow.\n\nThe verdict's rules live on DiagnosisStatusUpdate rather than here, so\nthe offline sync path is held to them too; FastAPI answers a body that\nbreaks them with 422.\n\nThe validation is recorded beside the verdict: `lesion_rating` (the\nslider, 0-10, required), the note (optional, also when disagreeing), the\nsigned-in doctor as `validated_by`, and `validated_at` (sent, or now).\nBack to pending clears them. A deleted validation cannot be edited.\n\nThe same conflict rules as sync, so a validation is never replaced by a\nchange made on an older copy: `base_version` must match the server's\nversion, and once the diagnosis is validated it must be sent. A\nconcurrent change that lands between the check and the write is caught\nby the version counter and answered the same way.",
        "operationId": "update_status_api_v1_diagnoses__diagnosis_id__status_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "diagnosis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Diagnosis Id"
            }
          },
          {
            "name": "x-device-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Id of this tablet in the device registry. Sent together with X-Device-Credential on every request once the tablet is activated, and checked whenever sent.",
              "title": "X-Device-Id"
            },
            "description": "Id of this tablet in the device registry. Sent together with X-Device-Credential on every request once the tablet is activated, and checked whenever sent."
          },
          {
            "name": "x-device-credential",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The credential the tablet received when it redeemed its activation code (or, before that flow, the one shown at registration).",
              "title": "X-Device-Credential"
            },
            "description": "The credential the tablet received when it redeemed its activation code (or, before that flow, the one shown at registration)."
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosisValidationPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosisOut"
                }
              }
            }
          },
          "409": {
            "description": "`version_conflict`: the diagnosis changed since `base_version`; `validation_exists`: it is already validated and no `base_version` was sent; `validation_deleted`: the doctor deleted this validation, so it cannot be edited. `detail.current_version` is the server's version."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnoses/{diagnosis_id}/validation": {
      "delete": {
        "tags": [
          "diagnoses"
        ],
        "summary": "Delete Diagnosis Validation",
        "description": "The doctor deletes the validation from the validation list.\n\nNot a reset to pending, and not a deletion of the screening: the patient,\nthe AI result, the X-ray and the heatmap stay, and so do the verdict, the\nratings and the note, for audit. `validation_deleted_at` and\n`validation_deleted_by` record when and by whom. The diagnosis then drops\nout of GET /validations and its totals, comes to tablets through\n/sync/pull with those fields set, and can no longer be edited.\n\nHeld to the same version check as an edit. Deleting one already deleted\nchanges nothing and answers 200, whatever `base_version` says, so a\nretried request is harmless.",
        "operationId": "delete_diagnosis_validation_api_v1_diagnoses__diagnosis_id__validation_delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "diagnosis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Diagnosis Id"
            }
          },
          {
            "name": "base_version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "The diagnosis `version` the doctor was looking at.",
              "title": "Base Version"
            },
            "description": "The diagnosis `version` the doctor was looking at."
          },
          {
            "name": "x-device-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Id of this tablet in the device registry. Sent together with X-Device-Credential on every request once the tablet is activated, and checked whenever sent.",
              "title": "X-Device-Id"
            },
            "description": "Id of this tablet in the device registry. Sent together with X-Device-Credential on every request once the tablet is activated, and checked whenever sent."
          },
          {
            "name": "x-device-credential",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The credential the tablet received when it redeemed its activation code (or, before that flow, the one shown at registration).",
              "title": "X-Device-Credential"
            },
            "description": "The credential the tablet received when it redeemed its activation code (or, before that flow, the one shown at registration)."
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Tenant-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosisOut"
                }
              }
            }
          },
          "409": {
            "description": "`version_conflict`: the diagnosis changed since `base_version`. `detail.current_version` is the server's version."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
